n\nLayar sistem Android adalah representasi alur; tampilannya mengikuti versi/perangkat pengguna.", "fontFamily": "Bit Sans", "fontStyle": "Regular", "fontSize": 15, "lineHeight": 22.5, "textAutoResize": "height", "fill": {"$var": "Text/Primary"}}, "select": false}, "as": "c63"}, {"command": "node.create", "params": {"type": "frame", "name": "Font & sumber implementasi", "parent": {"$ref": "c1"}, "x": 64, "y": 1280, "width": 1152, "height": 168, "props": {"fill": {"$var": "Surface/Raised"}, "cornerRadius": 12}, "select": false}, "as": "c64"}, {"command": "node.create", "params": {"type": "text", "name": "Font & sumber implementasi", "parent": {"$ref": "c64"}, "x": 24, "y": 20, "width": 1100, "height": 30, "props": {"characters": "Font & sumber implementasi", "fontFamily": "Bit Sans", "fontStyle": "Bold", "fontSize": 20, "lineHeight": 30.0, "textAutoResize": "height", "fill": {"$var": "Text/Primary"}}, "select": false}, "as": "c65"}, {"command": "node.create", "params": {"type": "text", "name": "Bit Sans Regular/Bold mengikuti asset aplikasi: assets/fonts/. Font dimuat pada sesi MCP; ", "parent": {"$ref": "c64"}, "x": 24, "y": 60, "width": 1100, "height": 23, "props": {"characters": "Bit Sans Regular/Bold mengikuti asset aplikasi: assets/fonts/. Font dimuat pada sesi MCP; file native tidak menyematkan font. Editor lain memerlukan Bit Sans tersedia, atau gunakan PNG preview.\n\nSetiap artboard menyimpan route, tema, versi dan nama source pada pluginData. Daftar lengkap: design/runtime-0.7.2/CAKUPAN-LAYAR.md.", "fontFamily": "Bit Sans", "fontStyle": "Regular", "fontSize": 15, "lineHeight": 22.5, "textAutoResize": "height", "fill": {"$var": "Text/Primary"}}, "select": false}, "as": "c66"}, {"command": "node.create", "params": {"type": "frame", "name": "Cakupan dan status", "parent": {"$ref": "c1"}, "x": 64, "y": 1472, "width": 1152, "height": 204, "props": {"fill": {"$var": "Surface/Raised"}, "cornerRadius": 12}, "select": false}, "as": "c67"}, {"command": "node.create"